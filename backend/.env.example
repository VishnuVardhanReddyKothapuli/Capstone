# Copy to backend/.env and edit. Values below match the built-in defaults, but
# the paths here are relative to the working directory — run uvicorn from
# backend/ so they land next to this file.

# ---- Storage ---------------------------------------------------------------
# Relational store: users, image bytes, thumbnails, verdicts. No embeddings.
# For MySQL:
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/sentinal
# (MySQL also needs `pip install PyMySQL`.)
DATABASE_URL=sqlite:///./sentinal.db

# Vector store: CLIP embeddings only.
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=image_embeddings

# ---- Auth ------------------------------------------------------------------
# REQUIRED before anyone else can reach this service. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-48-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
JWT_ISSUER=sentinal
JWT_AUDIENCE=sentinal-web
# Set this to the email stored on the one administrator's account. Leave empty
# to disable the admin area entirely.
ADMIN_EMAIL=
ENVIRONMENT=production

# ---- NSFW classification ---------------------------------------------------
# Tested models:
#   - Falconsai/nsfw_image_detection (Default: binary normal vs nsfw)
#   - AdamCodd/vit-base-nsfw-detector (Alternative binary ViT classifier)
NSFW_MODEL=Falconsai/nsfw_image_detection
# nsfw_score >= EXPLICIT              -> explicit (red)
# SUGGESTIVE <= nsfw_score < EXPLICIT -> suggestive (amber)
# nsfw_score <  SUGGESTIVE            -> safe (green)
NSFW_EXPLICIT_THRESHOLD=0.70
NSFW_SUGGESTIVE_THRESHOLD=0.40

# ---- Similarity ------------------------------------------------------------
# Tested models:
#   - openai/clip-vit-base-patch32 (Default: 512-dim fast embeddings)
#   - openai/clip-vit-base-patch16 (Finer-grained patch embeddings)
#   - openai/clip-vit-large-patch14 (768-dim high accuracy embeddings)
CLIP_MODEL=openai/clip-vit-base-patch32
SIMILARITY_TOP_K=5
SIMILARITY_COUNT_K=50
SIM_IDENTICAL_THRESHOLD=0.98
SIM_NEAR_DUPLICATE_THRESHOLD=0.92
SIM_SIMILAR_THRESHOLD=0.80
SIM_MATCH_FLOOR=0.60

# ---- Media handling --------------------------------------------------------
MAX_GIF_FRAMES=16
MAX_UPLOAD_BYTES=10485760
THUMBNAIL_SIZE=256

# ---- Gemini explanations ---------------------------------------------------
# Optional. With no key, the "Why this verdict?" box stays disabled and
# POST /api/checks/{id}/explain answers 503 — the two local checks are unaffected.
# Get one from https://aistudio.google.com/apikey
# NOTE: asking for an explanation uploads that image to Google.
# Tested working Gemini models:
#   - gemini-1.5-flash (Default: fast, balanced multimodal model)
#   - gemini-2.0-flash (Latest generation: high speed, multimodal)
#   - gemini-2.0-flash-lite (Ultra lightweight & fast)
#   - gemini-1.5-pro (Comprehensive reasoning)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_IMAGE_EDGE=1024

# ---- Serving ---------------------------------------------------------------
# Only needed while the Vite dev server runs on its own port.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
